---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Privacy Policy | Pool Services Spring TX" description="Privacy policy for poolservicesspringtx.com.">
  <section class="page-hero">
    <div class="container">
      <h1>Privacy Policy</h1>
      <p>How we handle information when you contact or visit us.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container" style="max-width:800px">
      <p>This website is operated by Pool Services Spring TX. We respect your privacy.</p>
      <h2>Information We Collect</h2>
      <p>When you call or request service we collect only the information needed to schedule and perform work (name, address, phone, pool details). We do not sell personal information.</p>
      <h2>Website</h2>
      <p>Our site is static and does not use tracking cookies for advertising. Basic server logs may record IP addresses for security and performance.</p>
      <h2>Contact</h2>
      <p>Questions about this policy: call (281) 555-0199 or write to 18913 Tomato St #102, Spring, TX 77379.</p>
    </div>
  </section>
</Layout>
